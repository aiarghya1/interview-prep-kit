{
  "name": "interview-prep-kit",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "evaluate": "tsx packages/core/src/cli/evaluate.ts",
    "fixtures": "tsx packages/core/fixtures/serve.ts",
    "dev:api": "npm run dev -w @kit/api",
    "start:api": "npm run start -w @kit/api",
    "dev:web": "npm run dev -w @kit/web",
    "build:web": "npm run build -w @kit/web",
    "db:local": "node scripts/local-mongo.mjs",
    "test:e2e": "playwright test",
    "coverage": "npm run coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
