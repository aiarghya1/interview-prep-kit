# --- LLM (required) ---------------------------------------------------------
# Groq API key (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Comma-separated model list, tried in order. Models the key can't use are
# skipped; on a daily-limit 429 the client falls over to the next. Defaults to the list below if unset.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# Tokens-per-minute budget the client paces itself to (match your Groq tier).
GROQ_TPM=6000

# --- Public discussion search (optional) ------------------------------------
# Tavily search API key (free tier): https://app.tavily.com
# Without it, only Reddit and Hacker News are searched.
TAVILY_API_KEY=

# --- Retrieval ----------------------------------------------------------------
# Allow fetching private/loopback addresses. Defaults: allowed outside
# production, blocked when NODE_ENV=production. The batch command allows them
# unless this is "false" (test sites may be served from localhost).
ALLOW_PRIVATE_URLS=
# Minimum ms between requests to the same host during batch runs.
CRAWL_MIN_INTERVAL_MS=300

# --- Batch command time budget (optional) -------------------------------------
# EVAL_TOTAL_BUDGET_MS=840000
# EVAL_CASE_BUDGET_MS=170000

# --- API server (apps/api) ----------------------------------------------------
PORT=4000
# MongoDB connection string (MongoDB Atlas free M0 in production).
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit
# Secret for signing session tokens. Required in production, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Hard cap on one kit generation; optional steps are skipped as it approaches.
JOB_TIMEOUT_MS=360000
# Kits a user may have queued/generating at once.
MAX_ACTIVE_JOBS_PER_USER=5
# NODE_ENV=production blocks private/loopback URLs and marks cookies Secure.
NODE_ENV=development
